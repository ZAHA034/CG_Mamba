# Credentials / secrets (NEVER commit)
config/credentials.json
config/credentials.*.json
config/*.local.json
*.token
*.key
*.pem
.env
.env.*

# Data — raw + processed (track only PROVENANCE.json + manifests, not bulk data)
# NOTE: raw files live at data/raw/<source>/<station>/<year>.csv — one level deeper
# than a single '*' matches, so these patterns must be recursive ('**').
data/raw/**/*.csv
data/raw/**/*.parquet
data/raw/**/*.txt
data/raw/**/*.gz
data/interim/
data/processed/*.csv
data/processed/*.parquet

# Allow PROVENANCE + manifests
!data/raw/**/PROVENANCE.json
!data/raw/**/MANIFEST.md
!data/raw/**/SHA256SUMS
!data/processed/PREPROCESSING_MANIFEST.json
!data/processed/SHA256SUMS

