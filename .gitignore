# ── Public code release: internal / superseded / bulk (added 2026-08) ──
# WARNING: git only treats '#' as a comment at the START of a line. A trailing
# '# ...' becomes part of the pattern and silently disables it. Keep comments
# on their own lines below.

# ~2.3 GB cross-domain benchmark data (regenerable, not part of the ILI paper).
# Also a nested git repository — without this it would be committed as a broken gitlink.
external/

# internal planning doc — NOT for public release
CG_Mamba_PLAN.md

# internal paper-section drafts
docs/

# superseded draft directory
paper/

# superseded LaTeX package — CGM_v2_paper/ is the true source
latex_submission/

# scratch preflight outputs
outputs/

# analysis notebooks (clear outputs before optionally re-adding)
notebooks/

# paper LaTeX kept out of the CODE repo (author choice);
# the two pre-registrations under it are force-added — see RELEASE_MANIFEST.md
CGM_v2_paper/

texput.log
# NOTE: runs/ and data/processed/*.parquet are ignored above, but a curated set of SMALL canonical
# result artifacts must ship. They are committed with `git add -f` — see RELEASE_MANIFEST.md.

# cross-domain benchmark data (Whitfield 2002 cell-cycle microarray) — third-party
# bulk data, not referenced anywhere in the ILI manuscript; same rationale as external/
data/processed/whitfield2002/
data/processed/**/*.npz
